  <name>CineWindows</name>
  <summary>Play local and streamed media with libmpv</summary>
  <description>
    <p>
      CineWindows is a desktop media player built with Qt, QML, and libmpv. It
      supports hardware-accelerated playback, subtitles, playlists, streaming,
      video filters, screenshots, and a local companion remote.
    </p>
  </description>
  <developer id="com.gyrolet">
    <name>Ritesh Pandit</name>
  </developer>
